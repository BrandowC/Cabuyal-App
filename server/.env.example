# Cadena de conexión de Postgres (Railway, Render, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/cabuyal?schema=public"

# Secreto para firmar los JWT de sesión — usar un valor largo y aleatorio en producción
JWT_SECRET="cambia-este-valor-en-produccion"

# Origen permitido para CORS (la URL donde corre el frontend)
CLIENT_ORIGIN="http://localhost:5173"

# Puerto del servidor
PORT=4000

# "production" activa cookies solo-HTTPS
NODE_ENV=development

# Meses de antigüedad antes de borrar pedidos/ventas/domicilios (Fase 6)
RETENTION_MONTHS=8
